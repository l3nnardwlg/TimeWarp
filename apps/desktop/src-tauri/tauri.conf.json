{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeWarp",
  "version": "0.1.0",
  "identifier": "dev.timewarp.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TimeWarp",
        "width": 1300,
        "height": 860,
        "minWidth": 920,
        "minHeight": 580,
        "backgroundColor": "#0B0D12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:* ipc: http://ipc.localhost; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
